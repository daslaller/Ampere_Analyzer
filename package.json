{
  "name": "ampere-analyzer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 9002",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run test && npm run build",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.14.1",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "genkit": "^1.14.1",
    "svelte": "^5.19.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.5",
    "@types/node": "^20.17.24",
    "genkit-cli": "^1.14.1",
    "jsdom": "^25.0.1",
    "svelte-check": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  },
  "packageManager": "npm@10.9.2"
}
